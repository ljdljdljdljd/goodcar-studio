<Window x:Class="TurntableStudio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TurntableStudio.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="GoodCar 影棚拍摄系统" Height="800" Width="1400" MinHeight="800" MinWidth="1400"
        Background="#1E1E2E" Foreground="#CDD6F4"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 颜色令牌 (Catppuccin Mocha) -->
        <SolidColorBrush x:Key="BgBase" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#181825"/>
        <SolidColorBrush x:Key="BgCard" Color="#313244"/>
        <SolidColorBrush x:Key="Border" Color="#45475A"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#CDD6F4"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A6ADC8"/>
        <SolidColorBrush x:Key="BrandPurple" Color="#CBA6F7"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#A6E3A1"/>
        <SolidColorBrush x:Key="ErrorRed" Color="#F38BA8"/>
        <SolidColorBrush x:Key="WarningYellow" Color="#F9E2AF"/>
        <SolidColorBrush x:Key="Overlay" Color="#11111B"/>

        <!-- ComboBox 全局样式（修复文字不可见问题）-->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Grid.Column="2"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate>
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource TextPrimary}"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,6,28,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}"
                                            BorderThickness="1" CornerRadius="4" Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Name="Border" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource Border}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button 全局样式（专业工业风格）-->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource Border}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrandPurple}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BgSecondary}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrandPurple}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态圆点样式 -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 操作按钮样式 -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标签样式 -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <!-- 输入框样式 -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- 分步引导卡片样式 -->
        <Style x:Key="StepBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ══════════════════════════════════════════════════════════════
             顶部状态栏：PLC状态 | 相机状态 | 右对齐标题
             ══════════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BgSecondary}" Padding="16,10" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="PLC" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <Ellipse Fill="{Binding PlcStatusColor}" Style="{StaticResource StatusDot}"/>
                    <TextBlock Text="{Binding PlcStatusText}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,16,0"/>

                    <TextBlock Text="相机" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <Ellipse Fill="{Binding CameraStatusColor}" Style="{StaticResource StatusDot}"/>
                    <TextBlock Text="{Binding CameraStatusText}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,16,0"/>

                    <Rectangle Width="1" Height="20" Fill="{StaticResource Border}" Margin="0,0,16,0"/>
                    <TextBlock Text="角度" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding AngleStatusText}" VerticalAlignment="Center" Foreground="{StaticResource SuccessGreen}" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock Text="GoodCar 影棚拍摄系统 v4.0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#6C7086" FontSize="12"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             底部操作栏：[连接PLC] [连接相机] [实时取景] ║ [开始/停止拍摄]
             ══════════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgSecondary}" Padding="16,12" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="{Binding ConnectPlcLabel}" Command="{Binding ConnectPlcCommand}" Style="{StaticResource ActionBtn}"/>
                <Button Content="{Binding ConnectCameraLabel}" Command="{Binding ConnectCameraCommand}" Style="{StaticResource ActionBtn}"/>
                <Button Content="{Binding LiveViewLabel}" Command="{Binding ToggleLiveViewCommand}" Style="{StaticResource ActionBtn}"/>

                <!-- 分隔线 -->
                <Rectangle Width="2" Height="30" Fill="{StaticResource Border}" Margin="12,0"/>

                <!-- 开始/停止拍摄（突出显示）-->
                <Button Content="{Binding StartStopLabel}"
                        Command="{Binding StartStopCommand}"
                        IsEnabled="{Binding CanStartCapture}"
                        Background="{Binding StartStopColor}"
                        Foreground="#1E1E2E"
                        FontWeight="Bold" FontSize="14"
                        Padding="28,10" Margin="6,0"
                        BorderBrush="{StaticResource Border}" BorderThickness="1" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             TabControl：自动拍摄 | 转盘控制
             ══════════════════════════════════════════════════════════════ -->
        <TabControl Background="{StaticResource BgBase}" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="{StaticResource BgCard}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Padding" Value="20,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Background="{TemplateBinding Background}"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1,1,1,0"
                                        CornerRadius="4,4,0,0" Margin="2,0">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{StaticResource BgBase}"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrandPurple}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ═══════════════════════════════════════════════════════
                 Tab 1: 自动拍摄（原有功能）
                 ═══════════════════════════════════════════════════════ -->
            <TabItem Header="自动拍摄">
                <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- ────────────────────────────────────────────────────────
                 左：三层叠加（实时取景 / 角度表盘 / 缩略图预览）
                 ──────────────────────────────────────────────────────── -->
            <Border Grid.Column="0" Background="#11111B" Margin="12">
                <Grid>
                    <!-- Layer 1: 实时取景图像（LiveViewActive=True 时显示）-->
                    <Image Source="{Binding LiveViewImage}" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LiveViewActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <!-- Layer 2: 角度表盘（LiveViewActive=False 且 ShotThumbnails 为空时显示）-->
                    <Canvas Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas.Style>
                            <Style TargetType="Canvas">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding LiveViewActive}" Value="False"/>
                                            <Condition Binding="{Binding ShotThumbnails.Count}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Canvas.Style>

                        <!-- 表盘底盘圆 -->
                        <Ellipse Width="280" Height="280" Canvas.Left="10" Canvas.Top="10" Stroke="#45475A" StrokeThickness="3" Fill="#181825"/>

                        <!-- 刻度线：每 30° 一个大刻度（12个），每 10° 一个小刻度（36个）-->
                        <!-- 0° -->
                        <Line X1="150" Y1="20" X2="150" Y2="40" Stroke="White" StrokeThickness="2"/>
                        <TextBlock Text="0°" Canvas.Left="143" Canvas.Top="2" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        <!-- 30° -->
                        <Line X1="221" Y1="47" X2="209" Y2="62" Stroke="White" StrokeThickness="2"/>
                        <!-- 60° -->
                        <Line X1="264" Y1="107" X2="249" Y2="119" Stroke="White" StrokeThickness="2"/>
                        <!-- 90° -->
                        <Line X1="280" Y1="150" X2="260" Y2="150" Stroke="White" StrokeThickness="2"/>
                        <TextBlock Text="90°" Canvas.Left="285" Canvas.Top="143" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        <!-- 120° -->
                        <Line X1="264" Y1="193" X2="249" Y2="181" Stroke="White" StrokeThickness="2"/>
                        <!-- 150° -->
                        <Line X1="221" Y1="253" X2="209" Y2="238" Stroke="White" StrokeThickness="2"/>
                        <!-- 180° -->
                        <Line X1="150" Y1="280" X2="150" Y2="260" Stroke="White" StrokeThickness="2"/>
                        <TextBlock Text="180°" Canvas.Left="137" Canvas.Top="285" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        <!-- 210° -->
                        <Line X1="79" Y1="253" X2="91" Y2="238" Stroke="White" StrokeThickness="2"/>
                        <!-- 240° -->
                        <Line X1="36" Y1="193" X2="51" Y2="181" Stroke="White" StrokeThickness="2"/>
                        <!-- 270° -->
                        <Line X1="20" Y1="150" X2="40" Y2="150" Stroke="White" StrokeThickness="2"/>
                        <TextBlock Text="270°" Canvas.Left="-20" Canvas.Top="143" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        <!-- 300° -->
                        <Line X1="36" Y1="107" X2="51" Y2="119" Stroke="White" StrokeThickness="2"/>
                        <!-- 330° -->
                        <Line X1="79" Y1="47" X2="91" Y2="62" Stroke="White" StrokeThickness="2"/>

                        <!-- 小刻度线（每10°，共36条，简化为8条示意）-->
                        <Line X1="150" Y1="20" X2="150" Y2="32" Stroke="#6C7086" StrokeThickness="1" Canvas.Left="35" Canvas.Top="13"/>
                        <Line X1="150" Y1="20" X2="150" Y2="32" Stroke="#6C7086" StrokeThickness="1" Canvas.Left="-35" Canvas.Top="13"/>
                        <Line X1="150" Y1="268" X2="150" Y2="280" Stroke="#6C7086" StrokeThickness="1" Canvas.Left="35"/>
                        <Line X1="150" Y1="268" X2="150" Y2="280" Stroke="#6C7086" StrokeThickness="1" Canvas.Left="-35"/>

                        <!-- 红色指针（RotateTransform 绑定 DialRotation）-->
                        <Path Data="M 150,150 L 145,30 L 150,20 L 155,30 Z" Fill="#F38BA8" Stroke="#F38BA8" StrokeThickness="1">
                            <Path.RenderTransform>
                                <RotateTransform Angle="{Binding DialRotation}" CenterX="150" CenterY="150"/>
                            </Path.RenderTransform>
                        </Path>

                        <!-- 中心圆 + 当前角度大字 -->
                        <Ellipse Width="80" Height="80" Canvas.Left="110" Canvas.Top="110" Fill="#1E1E2E" Stroke="#CBA6F7" StrokeThickness="2"/>
                        <TextBlock Text="{Binding CurrentAngleText}" Canvas.Left="115" Canvas.Top="130" Foreground="#CBA6F7" FontSize="20" FontWeight="Bold" TextAlignment="Center" Width="70"/>
                    </Canvas>

                    <!-- Layer 3: 缩略图预览系统（ShotThumbnails.Count > 0 时显示）-->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShotThumbnails.Count, Converter={x:Static vm:GreaterThanZeroConverter.Instance}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：缩略图流（WrapPanel）-->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                            <ItemsControl ItemsSource="{Binding ShotThumbnails}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="164" Height="144" Margin="4" Background="{StaticResource BgCard}" CornerRadius="4"
                                                BorderThickness="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}, Path=DataContext.LatestShot}" Value="{Binding}">
                                                            <Setter Property="BorderBrush" Value="{StaticResource BrandPurple}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Width="160" Height="120" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                <Border Height="20" VerticalAlignment="Bottom" Background="#CC181825">
                                                    <Grid Margin="4,0">
                                                        <TextBlock Text="{Binding NumberText}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Left"/>
                                                        <TextBlock Text="{Binding AngleText}" Foreground="{StaticResource TextSecondary}" FontSize="11" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 右侧：最新照片大图预览 -->
                        <Border Grid.Column="1" Background="{StaticResource BgCard}" Margin="4,8,8,8" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <TextBlock Text="最新照片" Foreground="{StaticResource BrandPurple}" FontSize="13" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                <Image Source="{Binding LatestShot.Thumbnail}" Stretch="Uniform" MaxHeight="400"/>
                                <TextBlock Text="{Binding LatestShot.NumberText}" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,8,0,2" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding LatestShot.AngleText}" Foreground="{StaticResource TextSecondary}" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Border>

            <!-- ────────────────────────────────────────────────────────
                 右：分步引导 + 配置区 + 实时角度 + 进度 + 日志流
                 ──────────────────────────────────────────────────────── -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,12,12,12">

                    <!-- ① 分步引导卡（Step 1-4）-->
                    <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="操作步骤" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrandPurple}" Margin="0,0,0,8"/>

                            <!-- Step 1: 连接 PLC -->
                            <Border BorderBrush="{Binding Step1Brush}" Style="{StaticResource StepBox}">
                                <TextBlock Foreground="{Binding Step1Brush}" FontWeight="SemiBold">
                                    <Run Text="Step 1:"/><Run Text=" 连接 PLC"/>
                                </TextBlock>
                            </Border>

                            <!-- Step 2: 连接相机 -->
                            <Border BorderBrush="{Binding Step2Brush}" Style="{StaticResource StepBox}">
                                <TextBlock Foreground="{Binding Step2Brush}" FontWeight="SemiBold">
                                    <Run Text="Step 2:"/><Run Text=" 连接相机"/>
                                </TextBlock>
                            </Border>

                            <!-- Step 3: 开启实时取景 -->
                            <Border BorderBrush="{Binding Step3Brush}" Style="{StaticResource StepBox}">
                                <TextBlock Foreground="{Binding Step3Brush}" FontWeight="SemiBold">
                                    <Run Text="Step 3:"/><Run Text=" 开启实时取景"/>
                                </TextBlock>
                            </Border>

                            <!-- Step 4: 开始拍摄 -->
                            <Border BorderBrush="{Binding Step4Brush}" Style="{StaticResource StepBox}">
                                <TextBlock Foreground="{Binding Step4Brush}" FontWeight="SemiBold">
                                    <Run Text="Step 4:"/><Run Text=" 开始拍摄"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ② 配置区 -->
                    <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="拍摄配置" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrandPurple}" Margin="0,0,0,8"/>

                            <TextBlock Text="PLC IP 地址" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding PlcIp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" IsEnabled="{Binding PlcConnected, Converter={x:Static vm:InvertBoolConverter.Instance}}"/>

                            <TextBlock Text="拍摄张数" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding ShotCountOptions}"
                                      SelectedItem="{Binding SelectedShotCount}"
                                      IsEnabled="{Binding CanChangeShotCount}"
                                      Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}"
                                      BorderBrush="{StaticResource Border}" BorderThickness="1"
                                      Padding="8,6" FontSize="13">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='{}{0} 张'}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="步进角度" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding StepAngle}" Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="0,4,0,0"/>

                            <TextBlock Text="提前触发量 (°)" Style="{StaticResource Label}"/>
                            <Grid Margin="0,4,0,0">
                                <Slider Minimum="0.1" Maximum="2.0" SmallChange="0.1" IsSnapToTickEnabled="True"
                                        TickFrequency="0.1" Value="{Binding LeadAngle}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LeadAngle, StringFormat='{}{0:F1}°'}" Width="40" TextAlignment="Right"
                                           Foreground="{StaticResource TextPrimary}" FontSize="12" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                            </Grid>
                            <TextBlock Text="角度偏后时增大此值（建议 0.3~1.0°）" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>

                            <TextBlock Text="照片保存目录" Style="{StaticResource Label}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SaveFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
                                <Button Grid.Column="1" Content="浏览" Command="{Binding BrowseFolderCommand}" Style="{StaticResource ActionBtn}" Margin="6,0,0,0" Padding="12,6"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ③ 实时角度大字 -->
                    <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="当前转盘角度" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrandPurple}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding CurrentAngleText}" Foreground="{StaticResource SuccessGreen}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ④ 进度区 -->
                    <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="拍摄进度" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrandPurple}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource SuccessGreen}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar Value="{Binding ProgressCurrent, Mode=OneWay}" Maximum="{Binding ProgressTotal, Mode=OneWay}" Height="10" Background="{StaticResource BgCard}" Foreground="{StaticResource SuccessGreen}" BorderThickness="0"/>
                            <TextBlock Margin="0,8,0,0">
                                <Run Text="当前角度：" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                <Run Text="{Binding CurrentAngleText, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ⑤ 彩色日志流（ItemsControl 绑定 AutoCaptureLog）-->
                    <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="运行日志" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrandPurple}" Margin="0,0,0,8"/>
                            <ScrollViewer Height="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding AutoCaptureLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Foreground="{Binding Color}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,1">
                                                <Run Text="{Binding Time, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Message, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════
                 Tab 2: 转盘控制（手动控制）
                 ═══════════════════════════════════════════════════════ -->
            <TabItem Header="转盘控制">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="800">

                        <!-- 参数配置区 -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="转盘参数配置" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrandPurple}" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="旋转速度" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding TurntableSpeed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" IsEnabled="{Binding PlcConnected}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Text="每度脉冲数" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding TurntablePulse, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" IsEnabled="{Binding PlcConnected}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="加减速时间 (ms)" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding TurntableAccelDecel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" IsEnabled="{Binding PlcConnected}"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="写入参数" Command="{Binding WriteParamsCommand}" Style="{StaticResource ActionBtn}"
                                        IsEnabled="{Binding CanUseManual}" HorizontalAlignment="Left" Padding="20,8" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 方向选择区 -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="旋转方向" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrandPurple}" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="正转" IsChecked="{Binding IsForwardDirection}" Foreground="{StaticResource TextPrimary}"
                                                 FontSize="14" Margin="0,0,24,0" IsEnabled="{Binding CanUseManual}"/>
                                    <RadioButton Content="反转" IsChecked="{Binding IsForwardDirection, Converter={x:Static vm:InvertBoolConverter.Instance}}"
                                                 Foreground="{StaticResource TextPrimary}" FontSize="14" IsEnabled="{Binding CanUseManual}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 目标角度移动区 -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="移动到目标角度" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrandPurple}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="目标角度 (0-360°)" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding TargetAngle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" IsEnabled="{Binding CanUseManual}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="▶ 正转到目标" Command="{Binding MoveForwardCommand}" Style="{StaticResource ActionBtn}"
                                            IsEnabled="{Binding CanUseManual}" Padding="16,8" Margin="0,20,8,0" VerticalAlignment="Bottom"/>
                                    <Button Grid.Column="2" Content="◀ 反转到目标" Command="{Binding MoveReverseCommand}" Style="{StaticResource ActionBtn}"
                                            IsEnabled="{Binding CanUseManual}" Padding="16,8" Margin="0,20,0,0" VerticalAlignment="Bottom"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 手动点动区 -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="手动点动" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrandPurple}" Margin="0,0,0,8"/>
                                <TextBlock Text="按住按钮转动，松开停止" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="▶ 手动正转" Style="{StaticResource ActionBtn}" IsEnabled="{Binding PlcConnected}"
                                            Margin="0,0,12,0" Padding="24,12" FontSize="14"
                                            PreviewMouseLeftButtonDown="ManualForwardDown"
                                            PreviewMouseLeftButtonUp="ManualJogUp"
                                            LostMouseCapture="ManualJogLostCapture"/>
                                    <Button Content="◀ 手动反转" Style="{StaticResource ActionBtn}" IsEnabled="{Binding PlcConnected}"
                                            Padding="24,12" FontSize="14"
                                            PreviewMouseLeftButtonDown="ManualReverseDown"
                                            PreviewMouseLeftButtonUp="ManualJogUp"
                                            LostMouseCapture="ManualJogLostCapture"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 启停控制区 -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="启停控制" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrandPurple}" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="▶ 启动" Command="{Binding StartRotationCommand}" Style="{StaticResource ActionBtn}"
                                            IsEnabled="{Binding CanUseManual}" Margin="0,0,12,0" Padding="24,12" FontSize="14"
                                            Background="{StaticResource SuccessGreen}" Foreground="#1E1E2E"/>
                                    <Button Content="■ 停止" Command="{Binding StopRotationCommand}" Style="{StaticResource ActionBtn}"
                                            IsEnabled="{Binding PlcConnected}" Margin="0,0,12,0" Padding="24,12" FontSize="14"
                                            Background="{StaticResource ErrorRed}" Foreground="#1E1E2E"/>
                                    <Button Content="⌂ 回零" Command="{Binding GoHomeCommand}" Style="{StaticResource ActionBtn}"
                                            IsEnabled="{Binding CanUseManual}" Padding="24,12" FontSize="14"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 当前角度显示 -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="当前转盘角度" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrandPurple}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding CurrentAngleText}" Foreground="{StaticResource SuccessGreen}"
                                           FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 操作日志 -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="16">
                            <StackPanel>
                                <TextBlock Text="运行日志" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrandPurple}" Margin="0,0,0,8"/>
                                <ScrollViewer Height="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding TurntableLog}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Foreground="{Binding Color}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,1">
                                                    <Run Text="{Binding Time, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Message, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════
                 Tab 3: 相机状态（新增）
                 ═══════════════════════════════════════════════════════ -->
            <TabItem Header="相机">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="600">

                        <!-- 相机信息卡 -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="相机信息" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrandPurple}" Margin="0,0,0,12"/>

                                <TextBlock Text="机型" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding CameraModel}" Foreground="{StaticResource TextPrimary}" FontSize="14" Margin="0,4,0,12"/>

                                <TextBlock Text="连接状态" Style="{StaticResource Label}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                    <Ellipse Fill="{Binding CameraStatusColor}" Width="12" Height="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding CameraStatusText}" Foreground="{Binding CameraStatusColor}" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="连接相机" Command="{Binding ConnectCameraCommand}" Style="{StaticResource ActionBtn}" Margin="0,0,12,0"/>
                                    <Button Content="重新连接" Command="{Binding ReconnectCameraCommand}" Style="{StaticResource ActionBtn}" IsEnabled="{Binding CameraConnected}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 拍摄前检查清单 -->
                        <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="16">
                            <StackPanel>
                                <TextBlock Text="拍摄前检查清单" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrandPurple}" Margin="0,0,0,12"/>

                                <TextBlock Text="✓ 相机设置为 USB 遥控模式（PC Remote）" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,4"/>
                                <TextBlock Text="✓ 相机存储卡已插入且有足够空间" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,4"/>
                                <TextBlock Text="✓ 相机电源充足或已连接外接电源" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,4"/>
                                <TextBlock Text="✓ 镜头设置为 MF 手动对焦模式" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,4"/>
                                <TextBlock Text="✓ 断开其他遥控设备（手机 App 等）" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,4"/>
                                <TextBlock Text="✓ USB 连接线牢固，无松动" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,4"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
