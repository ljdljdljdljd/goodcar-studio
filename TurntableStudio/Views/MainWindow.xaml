<Window x:Class="TurntableStudio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TurntableStudio.ViewModels"
        Title="GoodCar 影棚拍摄控制台" Height="720" Width="1100"
        Background="#1E1E2E" Foreground="#CDD6F4"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- 状态圆点 -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 操作按钮 -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!-- 标签 -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <!-- 输入框 -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ── 顶部状态栏 ── -->
        <Border DockPanel.Dock="Top" Background="#181825" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="PLC" VerticalAlignment="Center" FontWeight="Bold"/>
                <Ellipse Style="{StaticResource StatusDot}">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{Binding PlcConnected,
                            Converter={x:Static vm:BoolToColorConverter.Instance},
                            ConverterParameter='#A6E3A1|#F38BA8'}"/>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="{Binding PlcConnected, StringFormat='{}  {0}'}"
                           VerticalAlignment="Center" Margin="0,0,24,0"/>

                <TextBlock Text="相机" VerticalAlignment="Center" FontWeight="Bold"/>
                <Ellipse Style="{StaticResource StatusDot}">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{Binding CameraConnected,
                            Converter={x:Static vm:BoolToColorConverter.Instance},
                            ConverterParameter='#A6E3A1|#F38BA8'}"/>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="{Binding CameraConnected, StringFormat='{}  {0}'}"
                           VerticalAlignment="Center"/>

                <TextBlock Text="GoodCar 影棚拍摄系统 v1.0"
                           HorizontalAlignment="Right" Foreground="#6C7086"
                           VerticalAlignment="Center" Margin="40,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── 底部操作栏 ── -->
        <Border DockPanel.Dock="Bottom" Background="#181825" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="{Binding PlcConnected, Converter={x:Static vm:BoolToTextConverter.Instance},
                        ConverterParameter='断开PLC|连接PLC'}"
                        Command="{Binding ConnectPlcCommand}"
                        Style="{StaticResource ActionBtn}"/>
                <Button Content="{Binding CameraConnected, Converter={x:Static vm:BoolToTextConverter.Instance},
                        ConverterParameter='断开相机|连接相机'}"
                        Command="{Binding ConnectCameraCommand}"
                        Style="{StaticResource ActionBtn}"/>
                <Button Content="{Binding LiveViewActive, Converter={x:Static vm:BoolToTextConverter.Instance},
                        ConverterParameter='关闭取景|实时取景'}"
                        Command="{Binding ToggleLiveViewCommand}"
                        Style="{StaticResource ActionBtn}"/>
                <Button Content="{Binding StartStopLabel}"
                        Command="{Binding StartStopCommand}"
                        Style="{StaticResource ActionBtn}"
                        Background="#313244" Foreground="#A6E3A1"
                        FontWeight="Bold" FontSize="14" Padding="24,8"/>
            </StackPanel>
        </Border>

        <!-- ── 主体区域 ── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- 左：实时取景预览 -->
            <Border Grid.Column="0" Background="#11111B" Margin="8">
                <Grid>
                    <Image Source="{Binding LiveViewImage}" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="实时取景（点击底部按钮开启）"
                               Foreground="#45475A" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LiveViewImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 右：配置 + 进度 + 日志 -->
            <StackPanel Grid.Column="1" Margin="0,8,8,8">

                <!-- 配置区 -->
                <Border Background="#181825" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="拍摄配置" FontWeight="Bold" FontSize="14"
                                   Foreground="#CBA6F7" Margin="0,0,0,8"/>

                        <TextBlock Text="PLC IP 地址" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding PlcIp, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Input}"/>

                        <TextBlock Text="拍摄张数" Style="{StaticResource Label}"/>
                        <ComboBox ItemsSource="{Binding ShotCountOptions}"
                                  SelectedItem="{Binding SelectedShotCount}"
                                  IsEnabled="{Binding IsCapturing, Converter={x:Static vm:InvertBoolConverter.Instance}}"
                                  Background="#313244" Foreground="#CDD6F4"
                                  BorderBrush="#45475A" Padding="6,4" FontSize="13">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='{}{0} 张'}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="照片保存目录" Style="{StaticResource Label}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding SaveFolder, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Input}"/>
                            <Button Grid.Column="1" Content="浏览"
                                    Command="{Binding BrowseFolderCommand}"
                                    Style="{StaticResource ActionBtn}"
                                    Margin="4,0,0,0" Padding="8,4"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 进度区 -->
                <Border Background="#181825" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="拍摄进度" FontWeight="Bold" FontSize="14"
                                       Foreground="#CBA6F7" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding ProgressText}"
                                       Foreground="#A6E3A1" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                        <ProgressBar Value="{Binding ProgressCurrent}"
                                     Maximum="{Binding ProgressTotal}"
                                     Height="8" Background="#313244"
                                     Foreground="#A6E3A1"/>
                    </StackPanel>
                </Border>

                <!-- 日志区 -->
                <Border Background="#181825" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="运行日志" FontWeight="Bold" FontSize="14"
                                   Foreground="#CBA6F7" Margin="0,0,0,6"/>
                        <ScrollViewer Height="260" VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding Log, Mode=OneWay}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#A6ADC8" FontSize="11" FontFamily="Consolas"
                                     IsReadOnly="True" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
