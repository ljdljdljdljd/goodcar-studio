<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TurntableStudio</AssemblyName>
    <RootNamespace>TurntableStudio</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Huateng.Turntable.Sdk">
      <HintPath>..\libs\Huateng.Turntable.Sdk.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\libs\SonyCrBridge.dll" Condition="Exists('..\libs\SonyCrBridge.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\libs\Cr_Core.dll" Condition="Exists('..\libs\Cr_Core.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
